# Copy this file to `.env` and fill in your own values.
# Real environment variables always take precedence over values in this file.

# --- Huawei modem -----------------------------------------------------------
# IP of the modem's admin page (Huawei HiLink gateways usually use 192.168.8.1).
MODEM_IP=192.168.8.1
# Admin username for the modem.
MODEM_USER=admin
# REQUIRED. Admin password for the modem. Never commit the real value.
MODEM_PASS=

# --- Linux network ----------------------------------------------------------
# NetworkManager interface name for the modem (check with `nmcli device`).
MODEM_INTERFACE=vodafone0
# Your machine's IP on the modem's subnet (e.g. 192.168.8.104). Used by the
# policy-routing rule; leave empty to skip the `ip rule` step.
LOCAL_IP=192.168.8.104
# Routing table number used for the modem's default route.
ROUTING_TABLE=100

# --- Local proxy through which your traffic leaves (squid/tinyproxy) --------
PROXY_HOST=127.0.0.1
PROXY_PORT=3128

# --- Rotation behaviour -----------------------------------------------------
# Where to fetch the public IP to verify rotation worked.
IP_CHECK_URL=https://api.ipify.org
# "reboot" restarts the modem hardware; "toggle" flips mobile data off/on.
ROTATION_MODE=reboot
# Seconds to wait for the modem to come back after a reboot.
REBOOT_WAIT_SECONDS=35
# Seconds to wait for the ISP to release the lease during a data toggle.
TOGGLE_WAIT_SECONDS=35
# How many times to poll for a new public IP before giving up.
CONNECT_ATTEMPTS=15
# Seconds between each poll attempt.
CONNECT_RETRY_SECONDS=3

# --- HTTP rotation service --------------------------------------------------
# Address/port the /rotate HTTP service listens on.
ROTATION_HOST=0.0.0.0
ROTATION_PORT=5000
# Optional bearer-style token. If set, clients must send it as the
# `X-Auth-Token` header or the /rotate endpoint returns 401.
AUTH_TOKEN=

# --- Privileges -------------------------------------------------------------
# The rotation commands (nmcli/ip/sysctl) need root. Set false only when the
# service already runs as root (e.g. via systemd).
USE_SUDO=true
