#!/bin/sh
set -e

case "$1" in
  configure)
    # Create config directory if it doesn't exist
    if [ ! -d /etc/aintproxy ]; then
      mkdir -p /etc/aintproxy
    fi

    # Install default config only if not present
    if [ ! -f /etc/aintproxy/config.yaml ]; then
      cp /etc/aintproxy/config.yaml.dpkg-new /etc/aintproxy/config.yaml 2>/dev/null || true
    fi

    # Set proper permissions on config (contains password)
    chmod 600 /etc/aintproxy/config.yaml 2>/dev/null || true
    chown root:root /etc/aintproxy/config.yaml 2>/dev/null || true

    # Reload systemd if available
    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true
    fi
    ;;
esac

#DEBHELPER#
