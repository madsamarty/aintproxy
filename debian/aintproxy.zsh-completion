#compdef aintproxy

_aintproxy() {
    local -a commands
    commands=(
        'rotate:Run a single IP rotation'
        'hard-rotate:Full hardware modem reboot/reset'
        'serve:Start the HTTP rotation service'
        'drivers:List supported modem drivers'
        'version:Print version'
    )

    _arguments -C \
        '--config[Path to config file]:config file:_files' \
        '--help[Show help]' \
        '1:command:->cmd' \
        '*::arg:->args'

    case $state in
        cmd)
            _describe 'command' commands
            ;;
        args)
            case $words[1] in
                serve)
                    ;;
                *)
                    ;;
            esac
            ;;
    esac
}

_aintproxy "$@"
