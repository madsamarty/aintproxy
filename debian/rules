#!/bin/sh
set -ex

SRCDIR=$(pwd)
PKGDIR=${SRCDIR}/debian/tmp/aintscrape

case "$1" in
  clean)
    rm -f ${SRCDIR}/debian/aintscrape-bin
    rm -rf ${SRCDIR}/debian/tmp
    ;;

  build)
    mkdir -p ${SRCDIR}/.go
    GOPATH=${SRCDIR}/.go go build -o ${SRCDIR}/debian/aintscrape-bin .
    ;;

  install)
    rm -rf ${PKGDIR}
    mkdir -p ${PKGDIR}/usr/bin
    mkdir -p ${PKGDIR}/etc/aintscrape
    mkdir -p ${PKGDIR}/lib/systemd/system
    mkdir -p ${PKGDIR}/DEBIAN

    install -m 755 ${SRCDIR}/debian/aintscrape-bin ${PKGDIR}/usr/bin/aintscrape
    install -m 644 ${SRCDIR}/config.example.yaml ${PKGDIR}/etc/aintscrape/config.yaml
    install -m 644 ${SRCDIR}/debian/aintscrape.service ${PKGDIR}/lib/systemd/system/aintscrape.service

    cat > ${PKGDIR}/DEBIAN/control <<EOF
Package: aintscrape
Version: 0.1.0
Section: net
Priority: optional
Architecture: amd64
Maintainer: Mohamed Sameh <mohamed.sameh@example.com>
Recommends: sudo
Description: Modem IP rotator
 AintScrape forces a new public IP address by rebooting or toggling a
 4G/5G modem via its management API. It handles Linux routing
 (ip, sysctl) and exposes rotation as a CLI tool or HTTP endpoint.
 .
 Built for CGNAT environments where the ISP hands out fresh IPs on
 modem reconnect. Currently supports Huawei HiLink gateways.
EOF

    cat > ${PKGDIR}/DEBIAN/postinst <<'SCRIPT'
#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if ! id -u aintscrape >/dev/null 2>&1; then
        useradd --system --no-create-home --shell /usr/sbin/nologin aintscrape || true
    fi
    chown root:aintscrape /etc/aintscrape/config.yaml || true
    chmod 640 /etc/aintscrape/config.yaml || true
    systemctl daemon-reload || true
    systemctl enable aintscrape.service || true
fi
SCRIPT
    chmod 0755 ${PKGDIR}/DEBIAN/postinst

    cat > ${PKGDIR}/DEBIAN/postrm <<'SCRIPT'
#!/bin/sh
set -e
if [ "$1" = "remove" ]; then
    systemctl stop aintscrape.service 2>/dev/null || true
    systemctl disable aintscrape.service 2>/dev/null || true
    systemctl daemon-reload || true
    userdel aintscrape 2>/dev/null || true
fi
SCRIPT
    chmod 0755 ${PKGDIR}/DEBIAN/postrm
    ;;

  binary)
    $0 install
    dpkg-deb --build ${PKGDIR} ${SRCDIR}/../
    ;;

  *)
    echo "Usage: $0 {clean|build|install|binary}" >&2
    exit 1
    ;;
esac
