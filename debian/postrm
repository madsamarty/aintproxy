#!/bin/sh
set -e

case "$1" in
  remove|purge)
    # Stop and disable the service if it's running
    if command -v systemctl >/dev/null 2>&1; then
      systemctl stop aintproxy 2>/dev/null || true
      systemctl disable aintproxy 2>/dev/null || true
      systemctl daemon-reload || true
    fi
    ;;
esac

#DEBHELPER#
