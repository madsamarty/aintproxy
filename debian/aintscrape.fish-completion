complete -c aintscrape -f

complete -c aintscrape -n '__fish_use_subcommand' -a rotate -d 'Run a single IP rotation'
complete -c aintscrape -n '__fish_use_subcommand' -a hard-rotate -d 'Full hardware modem reboot/reset'
complete -c aintscrape -n '__fish_use_subcommand' -a serve -d 'Start the HTTP rotation service'
complete -c aintscrape -n '__fish_use_subcommand' -a drivers -d 'List supported modem drivers'
complete -c aintscrape -n '__fish_use_subcommand' -a version -d 'Print version'

complete -c aintscrape -l config -r -F -d 'Path to config file'
complete -c aintscrape -l help -d 'Show help'
